# ============================================================================
# 模型接入配置
# ----------------------------------------------------------------------------
# 用法：不要用 cp 覆盖已有 .env —— 那会清空你已经填好的全部 Key。
#       改单个值请用：npm run env LLM_API_KEY=sk-xxxx
#       查看当前配置：npm run env --show
#       .env 已在 .gitignore 里，不会被提交，也不进回收站，删了无法恢复。
#
# 不填也能跑 —— 引擎会自动降级到"离线规则桩"，测试、评测、Demo 全部可用。
# ============================================================================

# ---- 必填：API Key ----
# 国内可选（任选其一，都是 OpenAI 兼容协议）：
#   DeepSeek       https://api.deepseek.com/v1                      deepseek-chat
#   阿里百炼/通义  https://dashscope.aliyuncs.com/compatible-mode/v1 qwen-plus
#                  （视觉/拍题用 qwen-vl-max）
#   智谱 GLM       https://open.bigmodel.cn/api/paas/v4              glm-4-plus
#                  （视觉/拍题用 glm-4v）
LLM_API_KEY=

# ---- 接口地址（OpenAI 兼容，末尾不要带 /chat/completions）----
LLM_BASE_URL=https://api.deepseek.com/v1

# ---- 模型名 ----
LLM_MODEL=deepseek-chat

# ---- 视觉模型（可选：拍照识题的备用通道）----
# 填上它 + 上面的 LLM_API_KEY，拍照识题就能用，不需要买 OCR 服务；
# 留空则只有配置了 ALIYUN_OCR_APPCODE 时拍照才可用。
# 百炼：qwen-vl-max   智谱：glm-4v-plus   两者都需要把 LLM_BASE_URL 指向对应厂商。
# 注意：视觉通道按 token 计费、公式转写不如专用 OCR 稳定，
#      且有 AppCode 时优先走 AppCode，这一项只在没有 AppCode 时生效。
LLM_VISION_MODEL=

# ---- 单次请求超时（毫秒）。理科长题建议不低于 30s ----
LLM_TIMEOUT_MS=45000

# ---- Demo 服务端口 ----
PORT=5173
HOST=127.0.0.1

# ============================================================================
# 教师视图口令（可选）
# ----------------------------------------------------------------------------
# 学生视图与教师视图在**服务端**就分开了：
#   /api/chat          只返回学生可见内容（无解题路径、无错因标签、无答案指纹）
#   /api/teacher/*     返回知识点、路径图谱、参考答案、错因统计、完整 trace
#
# 三种形态：
#   留空（本地）        → open：不需要口令，点一下就能进教师视图
#   填上口令            → key ：必须带对口令；不带口令一律 401
#   公网部署且留空       → off ：教师视图整体关闭（api/index.js 强制锁死）
#
# 为什么本地可以留空：自己看图谱/复盘时不该被口令挡着。
# 为什么公网必须锁：教师接口返回完整解题路径与参考答案，
#                  挂在公开链接上等于把答案发出去。
# 不要把口令写进任何前端文件。
# ============================================================================
TEACHER_KEY=

# ============================================================================
# 拍照识题（图像 → 题干）· 可选能力
# ----------------------------------------------------------------------------
# 不填也能跑：拍照入口显示"未启用"，文字导入链路完全不受影响。
#
# 走后端代理，凭据只放服务端。三条通道：
#   云市场商品（一个 AppCode，按次计费）→ ALIYUN_OCR_APPCODE
#   视觉模型（复用 LLM_API_KEY，按 token 计费）→ LLM_VISION_MODEL
#   官方 OCR（AK/SK + V3 签名）        → 尚未实现，见 docs/06
#
# 选择顺序：显式配 ALIYUN_OCR_PROVIDER 时按它走；否则
#   AppCode 存在 → marketplace；否则 视觉模型名 + Key 都在 → vision。
#
# 成本提醒：题目识别按「成功调用次数」计费（官方资源包标价约 0.083 元/次，
#          官方渠道另有 200 次/月免费额度；云市场渠道不含免费额度）。
#          因此拍照流程刻意做成"识别 → 回填输入框 → 学生确认 → 再读题"，
#          而不是一键直通：识别错一个数值会让整条读题链路悄悄跑偏。
#
# 拿 AppCode：云市场买家控制台 → 已购服务 → 该商品（或 API 网关控制台的「应用管理」）。
# 注意是 AppCode，不是 AppKey/AppSecret —— 后者用于签名认证，是另一套。
# ============================================================================
ALIYUN_OCR_APPCODE=

# 通道：marketplace | official（official 尚未实现）
ALIYUN_OCR_PROVIDER=marketplace

# 接口地址与传图字段名。
# 云市场题目识别（cmapi00043052）的契约（商品页「API 接口」栏）：
#   调用地址 https://mquestion.market.alicloudapi.com/ocrservice/mathQuestion
#   请求体 JSON，字段：img（纯 base64，不带 data: 前缀）/ url / prob / rotate
#   图片限制：base64 后 ≤4M，最短边 ≥15px，最长边 ≤4096px，支持 jpg/png/bmp
# 留空 = 由 src/core/ocr.js 的契约表取默认值（即上面这个地址）。
ALIYUN_OCR_ENDPOINT=
ALIYUN_OCR_IMAGE_FIELD=

# 超时与重试。重试默认 0：按次计费，失败重试等于再花钱。
# 只有"请求根本没到达服务端"（网络层失败）才会自动换候选。
ALIYUN_OCR_TIMEOUT_MS=30000
ALIYUN_OCR_RETRIES=0
